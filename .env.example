# SDD Environment Configuration
# Copy this file to .env and fill in the values for your environment.
# .env is ignored by .gitignore to prevent secrets from being committed.

# ============================================================================
# TELEMETRY & OBSERVABILITY
# ============================================================================

# OpenTelemetry (OTEL) Exporter Endpoint
# Used by sdd_runtime/telemetry.py for exporting metrics and spans
# Example: https://api.datadoghq.com/v1/input
SDD_OTEL_EXPORTER_ENDPOINT=

# OTEL API Key (SENSITIVE — required for authenticated OTEL export)
# Datadog API key or equivalent Bearer token
SDD_OTEL_API_KEY=

# ============================================================================
# ALERT WEBHOOKS
# ============================================================================

# Webhook URL for token economy alerts (generic or PagerDuty)
# Example: https://events.pagerduty.com/v2/enqueue
SDD_WEBHOOK_URL=

# Webhook type: "generic", "slack", or "pagerduty"
SDD_WEBHOOK_TYPE=generic

# Webhook timeout in seconds
SDD_WEBHOOK_TIMEOUT=5

# Comma-separated list of events to alert on
# Example: "token_budget_exceeded,context_compression_triggered"
SDD_WEBHOOK_EVENTS=

# PagerDuty routing key (SENSITIVE — only if SDD_WEBHOOK_TYPE=pagerduty)
SDD_PD_ROUTING_KEY=

# ============================================================================
# INTELLIGENCE & ML SERVICE
# ============================================================================

# External ML intelligence service endpoint
# Used by sdd_runtime/providers/http_provider.py
# Example: https://api.intelligence-service.internal/v1
SDD_INTELLIGENCE_URL=

# ============================================================================
# RUNTIME METRICS & BUDGET
# ============================================================================

# Token budget ceiling (default: 100000)
SDD_TOKEN_BUDGET_CEILING=100000

# Context compression threshold percentage (default: 70.0)
SDD_CONTEXT_COMPRESSION_THRESHOLD=70.0

# Context compression target percentage (default: 50.0)
SDD_CONTEXT_COMPRESSION_TARGET=50.0

# Tokens used in current run (set by runtime)
SDD_TOKENS_INPUT=

# Tokens generated in current run (set by runtime)
SDD_TOKENS_OUTPUT=

# ============================================================================
# GOVERNANCE & SIGNING
# ============================================================================

# Signing mode: "off", "warn", or "enforce"
SDD_SIGNATURE_MODE=warn

# Private key file for artifact signing (SENSITIVE)
# Path to Ed25519 private key file
SDD_SIGNING_PRIVATE_KEY_FILE=

# Public key file for artifact verification
SDD_SIGNING_PUBLIC_KEY_FILE=

# Signing key identifier (default: "dev-key")
SDD_SIGNING_KEY_ID=dev-key

# Require signatures on all artifacts: "" or "true"
SDD_SIGNING_REQUIRED=

# Trusted keyring directory override (path to directory with trusted public keys)
SDD_TRUSTED_KEYRING=

# ============================================================================
# GOVERNANCE COMPLIANCE
# ============================================================================

# Compliance log location override
# Default: .sdd/audit/compliance-events.jsonl
SDD_COMPLIANCE_LOG=

# Logging mode: "passive", "active", or "strict"
SDD_LOGGING_MODE=passive

# Runtime environment label (e.g., "dev", "prod", "ci")
SDD_ENV=dev

# ============================================================================
# IDENTITY & SESSION
# ============================================================================

# Agent/session identifier (UUID; auto-generated if not set)
SDD_AGENT_ID=

# Workspace profile ("master" or "client")
SDD_PROFILE=

# Unique path identifier for this workspace run
SDD_PATH_ID=

# Version stamp/tag
SDD_VERSION=

# ============================================================================
# PATHS & DIRECTORIES
# ============================================================================

# Override directory for generated seedlings (default: derived from workspace)
SDD_SEEDLINGS_DIR=

# Test output directory override (for isolated test runs)
SDD_TEST_OUTPUT_DIR=

# ============================================================================
# PARSER & DSL
# ============================================================================

# DSL parse mode: "regex" or "structured"
SDD_DSL_PARSE_MODE=regex

# ============================================================================
# METRICS & MONITORING
# ============================================================================

# Prometheus metrics port (default: 9090)
SDD_METRICS_PORT=9090

# Budget utilization percentage (computed at runtime)
SDD_BUDGET_UTILIZATION_PCT=

# ============================================================================
# CLI FEATURES
# ============================================================================

# Skip seedling regeneration during governance compile
SDD_SKIP_SEED_REGEN=

# ============================================================================
# CI/CD DETECTION
# ============================================================================

# Set automatically in CI environments (GitHub Actions, etc.)
# Checked by governance/compliance.py for environment detection
CI=

---
// Guardian-halo animated brand mark. Used in SiteNav on every page.
// Ported from the design handoff (ADR-023 — Providentian identity).
const BASE_URL = import.meta.env.BASE_URL;
---
<a class="brand" href={BASE_URL}>
  <span class="brand-halo"></span>
  <span class="brand-frame"></span>
  <span class="brand-mote" style="left:2px; top:3px; width:4px; height:4px; background:var(--bronze); animation-duration:7s; animation-delay:0s;"></span>
  <span class="brand-mote" style="right:4px; bottom:3px; width:3.5px; height:3.5px; background:var(--steel); animation-duration:8.5s; animation-delay:-3s;"></span>
  <span class="brand-mote" style="left:28px; top:-2px; width:3px; height:3px; background:var(--bronze-dim); animation-duration:6.5s; animation-delay:-1.5s;"></span>
  <span class="brand-mote" style="right:34px; bottom:-2px; width:3px; height:3px; background:var(--clean); animation-duration:9s; animation-delay:-5s;"></span>
  <span class="brand-mote" style="left:50%; top:-3px; width:2.5px; height:2.5px; background:var(--steel); animation-duration:7.8s; animation-delay:-2.4s;"></span>
  <span class="brand-mote" style="right:8px; top:1px; width:2.5px; height:2.5px; background:var(--bronze); animation-duration:8s; animation-delay:-6.2s;"></span>
  <span class="brand-mark">P</span>Providentian<span class="brand-suffix">Agent Governance</span>
</a>

<style>
  .brand-suffix {
    position: relative;
    z-index: 1;
    font-family: var(--sans);
    font-weight: 400;
    font-size: 11.5px;
    color: var(--ink-faint);
    margin-left: 8px;
    letter-spacing: 0.01em;
  }
</style>

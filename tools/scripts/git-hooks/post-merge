#!/bin/bash
# Post-merge Hook — SDD Architecture Framework
# Clears stale governance cache and warms it after a merge.

set -euo pipefail

PROJECT_ROOT="$(git rev-parse --show-toplevel)"
cd "$PROJECT_ROOT" || exit 1

YELLOW='\033[1;33m'
GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m'

echo -e "${YELLOW}[POST-MERGE] Refreshing governance cache...${NC}"

# ── Clear stale agent state cache ───────────────────────────────────────────
CACHE_FILE="$PROJECT_ROOT/.sdd/agent_state.json"
if [ -f "$CACHE_FILE" ]; then
    rm -f "$CACHE_FILE" && echo -e "${GREEN}✓ Cache cleared${NC}" || {
        echo -e "${RED}✗ Failed to clear cache: $CACHE_FILE${NC}"
        exit 1
    }
fi

# ── Resolve Python interpreter (shared guard with Makefile) ─────────────────
if ! command -v python3 >/dev/null 2>&1; then
    echo -e "${RED}✗ python3 not found on PATH — needed to run the venv guard${NC}"
    exit 1
fi
if ! PYTHON_BIN="$(python3 "$PROJECT_ROOT/tools/maintenance/make_tasks.py" check-venv)"; then
    echo -e "${RED}✗ venv guard failed — see error above. Run 'make install'.${NC}"
    exit 1
fi

# ── Warm cache via health check ──────────────────────────────────────────────
HEALTH_SCRIPT="$PROJECT_ROOT/tools/health/health_check.py"

if [ ! -f "$HEALTH_SCRIPT" ]; then
    echo -e "${YELLOW}⚠ Health check script not found — skipping cache warm${NC}"
    echo -e "${GREEN}[POST-MERGE] Done (cache cleared, no warm-up).${NC}"
    exit 0
fi

echo -e "${YELLOW}→ Warming cache state...${NC}"
if "$PYTHON_BIN" "$HEALTH_SCRIPT" >/dev/null 2>&1; then
    echo -e "${GREEN}✓ Cache warmed${NC}"
else
    echo -e "${RED}✗ Health check failed after merge — governance may need recompile${NC}"
    echo -e "  Run: sdd governance compile && sdd runtime status"
    exit 1
fi

echo -e "${GREEN}[POST-MERGE] Cache refreshed successfully.${NC}"
exit 0

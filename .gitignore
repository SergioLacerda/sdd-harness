# OS
.DS_Store
Thumbs.db

# SDD Profiles - generated via CLI; ignore runtime contents but keep safe/canonical files
# Git cannot re-include files inside a directory ignored with dir/, so use dir/*.
.sdd/*
# Trust: only public/keyring material is safe to commit
!.sdd/trust/
.sdd/trust/*
!.sdd/trust/trusted-keys.json
!.sdd/trust/README.md
# Compiled: only artifact signatures are committed
!.sdd/compiled/
.sdd/compiled/*
!.sdd/compiled/governance-core.json.sig
!.sdd/compiled/governance-client.json.sig
# Selector: metadata and mandates are canonical inputs needed by selector in CI/CD
!.sdd/metadata.json
!.sdd/source/
.sdd/source/*
!.sdd/source/mandates/
.sdd/source/mandates/*
!.sdd/source/mandates/mandates.md
!.sdd/source/guidelines.dsl

# Providence Profiles - generated via CLI; ignore runtime contents but keep safe/canonical files
# Mirrors the legacy .sdd policy for the .providence runtime directory.
.providence/*
# Trust: only public/keyring material is safe to commit
!.providence/trust/
.providence/trust/*
!.providence/trust/trusted-keys.json
!.providence/trust/README.md
# Compiled: only artifact signatures are committed
!.providence/compiled/
.providence/compiled/*
!.providence/compiled/governance-core.json.sig
!.providence/compiled/governance-client.json.sig
# Selector: metadata and mandates are canonical inputs needed by selector in CI/CD
!.providence/metadata.json
!.providence/source/
.providence/source/*
!.providence/source/mandates/
.providence/source/mandates/*
!.providence/source/mandates/mandates.md
!.providence/source/guidelines.dsl

# Project Specific
test_output.log
*.log
site/
_version.py

# Generated selector assets (built into docs_dir so MkDocs serves/copies them)
docs/selector/

# Dev Container - ignore dotfiles but keep the config files
.devcontainer/.*
!.devcontainer/devcontainer.json
!.devcontainer/post-create.sh
build/

# Drift battery local state - not for commit
examples/security/drift_battery_snapshot.json
.strategist/.compiled/

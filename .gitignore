# OS
.DS_Store
Thumbs.db

# SDD Agent Context — estado de runtime (gerado dinamicamente, nao versionar)
.ai/

# SDD Profiles — gerado via CLI, ignorar conteúdo mas manter arquivos de trust
# Git não suporta exceções dentro de diretórios ignorados via dir/,
# então usamos dir/* para poder abrir exceções em subdiretórios específicos.
.sdd/*
# Trust: apenas chaves públicas e keyring são seguros para commitar
!.sdd/trust/
.sdd/trust/*
!.sdd/trust/trusted-keys.json
# Compiled: apenas assinaturas dos artifacts são commitadas
!.sdd/compiled/
.sdd/compiled/*
!.sdd/compiled/governance-core.json.sig
!.sdd/compiled/governance-client.json.sig
# Selector: metadata e mandates são fontes canônicas necessárias para o selector em CI/CD
!.sdd/metadata.json
!.sdd/source/
.sdd/source/*
!.sdd/source/mandates/
.sdd/source/mandates/*
!.sdd/source/mandates/mandates.md
!.sdd/source/guidelines.dsl

# Project Specific
test_output.log
*.log
site/
_version.py

# Generated selector assets (built into docs_dir so MkDocs serves/copies them)
docs/selector/

# Dev Container — ignore dotfiles but keep the config files
.devcontainer/.*
!.devcontainer/devcontainer.json
!.devcontainer/post-create.sh
build/

# Drift battery local state — not for commit
examples/security/drift_battery_snapshot.json
.strategist/.compiled/

# Development artifacts (not needed in Docker build context)
# NOTE: .github/ is intentionally NOT excluded — tests/unit/ci/test_release_workflow_policy.py
# reads .github/workflows/*.yml from the repo root, and `make check` runs inside this
# container's shadow-repo copy of /app, so those workflow files must be present in the image.
.git/
.vscode/
.idea/
.venv/
venv/
node_modules/
**/node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Generated runtime state (compiled fresh inside builder stage)
generated/
.sdd/compiled/
.sdd/runtime/
.sdd/scratch/
.sdd-local/

# Local dev config
.env
*.local
erro_esteira*.txt
.sdd/.spec.config
.sdd/trust/

# Docs build output
docs/archive/
docs/site/
site/
